# คัดลอกเป็น .env
# true = ใช้ข้อมูลจำลองใน src/mocks/ ทำหน้าเว็บได้โดยไม่ต้องรัน server
VITE_USE_MOCK=false

# รูปแผนที่ (ไม่ใส่ = OpenStreetMap ซึ่งใช้ได้ฟรีสำหรับงานที่คนใช้ไม่มาก ต้องแสดงเครดิตเสมอ)
# ถ้าจะใช้ CARTO ต้องขอ API key ฟรีที่ https://carto.com/basemaps/apikey ก่อน แล้วใส่แบบนี้:
# VITE_TILE_URL=https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png?key=ใส่คีย์
# VITE_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors &copy; CARTO
# เปลี่ยนโดเมนแผนที่ต้องเพิ่มใน TILE_HOSTS ของ server/src/app.js ด้วย
VITE_TILE_URL=
VITE_TILE_ATTRIBUTION=

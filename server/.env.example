# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า (ห้าม commit ไฟล์ .env)
PORT=3001
NODE_ENV=development

# ฐานข้อมูล (ส่วน C/D) — ค่าตรงกับ docker-compose.yml สำหรับเครื่องตัวเองเท่านั้น
DATABASE_URL=postgres://tripfare:tripfare_dev_only@localhost:5432/tripfare

# สุ่มค่ายาว ๆ ของตัวเอง: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me
IP_HASH_SALT=change-me
